  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "build:web": "tsc --noEmit && VITE_ARCHSKETCH_BROWSER=1 vite build --outDir dist-web",
